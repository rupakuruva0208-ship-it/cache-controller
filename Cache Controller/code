`timescale 1ns/1ps

module cache_controller #(
    parameter ADDR_WIDTH = 8,
    parameter DATA_WIDTH = 8,
    parameter CACHE_LINES = 4
)(
    input                       clk,
    input                       reset,

    // CPU interface
    input                       cpu_read,
    input                       cpu_write,
    input  [ADDR_WIDTH-1:0]    cpu_addr,
    input  [DATA_WIDTH-1:0]     cpu_write_data,
    output reg [DATA_WIDTH-1:0] cpu_read_data,
    output reg                  cpu_ready,
    output reg                  cache_hit,

    // Main memory interface
    output reg                  mem_read,
    output reg                  mem_write,
    output reg [ADDR_WIDTH-1:0] mem_addr,
    output reg [DATA_WIDTH-1:0] mem_write_data,
    input      [DATA_WIDTH-1:0] mem_read_data
);

    localparam INDEX_WIDTH = 2;
    localparam TAG_WIDTH   = ADDR_WIDTH - INDEX_WIDTH;

    reg [DATA_WIDTH-1:0] cache_data [0:CACHE_LINES-1];
    reg [TAG_WIDTH-1:0] cache_tag  [0:CACHE_LINES-1];
    reg                  valid_bit [0:CACHE_LINES-1];
    reg                  dirty_bit [0:CACHE_LINES-1];

    integer i;

    wire [INDEX_WIDTH-1:0] index;
    wire [TAG_WIDTH-1:0] tag;

    assign index = cpu_addr[INDEX_WIDTH-1:0];
    assign tag   = cpu_addr[ADDR_WIDTH-1:INDEX_WIDTH];

    always @(posedge clk or posedge reset) begin
        if (reset) begin
            cpu_read_data <= 0;
            cpu_ready     <= 0;
            cache_hit     <= 0;

            mem_read      <= 0;
            mem_write     <= 0;
            mem_addr      <= 0;
            mem_write_data <= 0;

            for (i = 0; i < CACHE_LINES; i = i + 1) begin
                cache_data[i] <= 0;
                cache_tag[i]  <= 0;
                valid_bit[i]  <= 0;
                dirty_bit[i]  <= 0;
            end
        end
        else begin
            cpu_ready <= 0;
            cache_hit <= 0;
            mem_read  <= 0;
            mem_write <= 0;

            // CPU READ
            if (cpu_read) begin

                // Cache HIT
                if (valid_bit[index] && cache_tag[index] == tag) begin
                    cpu_read_data <= cache_data[index];
                    cpu_ready     <= 1;
                    cache_hit     <= 1;
                end

                // Cache MISS
                else begin
                    // Write back dirty cache line
                    if (valid_bit[index] && dirty_bit[index]) begin
                        mem_write      <= 1;
                        mem_addr       <= {cache_tag[index], index};
                        mem_write_data <= cache_data[index];
                    end

                    // Read new data from memory
                    mem_read <= 1;
                    mem_addr <= cpu_addr;

                    cache_data[index] <= mem_read_data;
                    cache_tag[index]  <= tag;
                    valid_bit[index]  <= 1;
                    dirty_bit[index]  <= 0;

                    cpu_read_data <= mem_read_data;
                    cpu_ready     <= 1;
                    cache_hit     <= 0;
                end
            end

            // CPU WRITE
            else if (cpu_write) begin

                // Write HIT
                if (valid_bit[index] && cache_tag[index] == tag) begin
                    cache_data[index] <= cpu_write_data;
                    dirty_bit[index]  <= 1;

                    cpu_ready <= 1;
                    cache_hit <= 1;
                end

                // Write MISS
                else begin
                    // Write old dirty data back to memory
                    if (valid_bit[index] && dirty_bit[index]) begin
                        mem_write      <= 1;
                        mem_addr       <= {cache_tag[index], index};
                        mem_write_data <= cache_data[index];
                    end

                    // Allocate new cache line
                    cache_tag[index]  <= tag;
                    cache_data[index] <= cpu_write_data;
                    valid_bit[index]  <= 1;
                    dirty_bit[index]  <= 1;

                    cpu_ready <= 1;
                    cache_hit <= 0;
                end
            end
        end
    end

endmodule