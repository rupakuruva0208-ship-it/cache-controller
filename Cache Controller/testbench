`timescale 1ns/1ps

module tb_cache_controller;

    parameter ADDR_WIDTH = 8;
    parameter DATA_WIDTH = 8;

    reg clk;
    reg reset;

    reg cpu_read;
    reg cpu_write;
    reg [ADDR_WIDTH-1:0] cpu_addr;
    reg [DATA_WIDTH-1:0] cpu_write_data;

    wire [DATA_WIDTH-1:0] cpu_read_data;
    wire cpu_ready;
    wire cache_hit;

    wire mem_read;
    wire mem_write;
    wire [ADDR_WIDTH-1:0] mem_addr;
    wire [DATA_WIDTH-1:0] mem_write_data;

    reg [DATA_WIDTH-1:0] mem_read_data;

    cache_controller uut (
        .clk(clk),
        .reset(reset),

        .cpu_read(cpu_read),
        .cpu_write(cpu_write),
        .cpu_addr(cpu_addr),
        .cpu_write_data(cpu_write_data),

        .cpu_read_data(cpu_read_data),
        .cpu_ready(cpu_ready),
        .cache_hit(cache_hit),

        .mem_read(mem_read),
        .mem_write(mem_write),
        .mem_addr(mem_addr),
        .mem_write_data(mem_write_data),
        .mem_read_data(mem_read_data)
    );

    // Clock generation
    always #5 clk = ~clk;

    // Simple memory model
    reg [7:0] memory [0:255];

    always @(*) begin
        mem_read_data = memory[mem_addr];
    end

    initial begin

        // Initialize memory
        memory[8'h10] = 8'hAA;
        memory[8'h20] = 8'hBB;
        memory[8'h30] = 8'hCC;

        clk = 0;
        reset = 1;

        cpu_read = 0;
        cpu_write = 0;
        cpu_addr = 0;
        cpu_write_data = 0;

        #15;
        reset = 0;

        // ------------------------------------------------
        // TEST 1: READ MISS
        // ------------------------------------------------
        #10;
        cpu_addr = 8'h10;
        cpu_read = 1;

        #10;
        cpu_read = 0;

        $display("TEST 1: READ MISS");
        $display("Address = %h, Data = %h, Hit = %b",
                  cpu_addr, cpu_read_data, cache_hit);

        // ------------------------------------------------
        // TEST 2: READ HIT
        // ------------------------------------------------
        #10;
        cpu_addr = 8'h10;
        cpu_read = 1;

        #10;
        cpu_read = 0;

        $display("TEST 2: READ HIT");
        $display("Address = %h, Data = %h, Hit = %b",
                  cpu_addr, cpu_read_data, cache_hit);

        // ------------------------------------------------
        // TEST 3: WRITE HIT
        // ------------------------------------------------
        #10;
        cpu_addr = 8'h10;
        cpu_write_data = 8'h55;
        cpu_write = 1;

        #10;
        cpu_write = 0;

        $display("TEST 3: WRITE HIT");
        $display("Address = %h, Write Data = %h, Hit = %b",
                  cpu_addr, cpu_write_data, cache_hit);

        // ------------------------------------------------
        // TEST 4: READ AFTER WRITE
        // ------------------------------------------------
        #10;
        cpu_addr = 8'h10;
        cpu_read = 1;

        #10;
        cpu_read = 0;

        $display("TEST 4: READ AFTER WRITE");
        $display("Address = %h, Data = %h, Hit = %b",
                  cpu_addr, cpu_read_data, cache_hit);

        // ------------------------------------------------
        // TEST 5: DIFFERENT ADDRESS - MISS
        // ------------------------------------------------
        #10;
        cpu_addr = 8'h20;
        cpu_read = 1;

        #10;
        cpu_read = 0;

        $display("TEST 5: READ MISS");
        $display("Address = %h, Data = %h, Hit = %b",
                  cpu_addr, cpu_read_data, cache_hit);

        #20;

        $finish;
    end

endmodule